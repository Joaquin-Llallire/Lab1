`timescale 1ns / 1ns

module cordic (
    input  wire               clk,
    input  wire               reset,
    input  wire               start,
    input  wire signed [31:0] angle,

    output reg  signed [31:0] cos_out,
    output reg  signed [31:0] sin_out,
    output reg                done
);

    localparam [1:0] IDLE    = 2'b00;
    localparam [1:0] INIT    = 2'b01;
    localparam [1:0] ITERATE = 2'b10;
    localparam [1:0] DONE    = 2'b11;

    localparam signed [31:0] K_INV_16 = 32'sh00009B75;

    reg [1:0] state;
    reg [3:0] iter;

    reg signed [31:0] x;
    reg signed [31:0] y;
    reg signed [31:0] z;

    function signed [31:0] atan_tabla;

        input [3:0] index;

        begin
            case (index)

                4'd0:  atan_tabla = 32'sh002D0000;
                4'd1:  atan_tabla = 32'sh001A90A7;
                4'd2:  atan_tabla = 32'sh000E0947;
                4'd3:  atan_tabla = 32'sh00072001;
                4'd4:  atan_tabla = 32'sh0003938B;
                4'd5:  atan_tabla = 32'sh0001CA38;
                4'd6:  atan_tabla = 32'sh0000E52A;
                4'd7:  atan_tabla = 32'sh00007297;
                4'd8:  atan_tabla = 32'sh0000394C;
                4'd9:  atan_tabla = 32'sh00001CA6;
                4'd10: atan_tabla = 32'sh00000E53;
                4'd11: atan_tabla = 32'sh00000729;
                4'd12: atan_tabla = 32'sh00000395;
                4'd13: atan_tabla = 32'sh000001CA;
                4'd14: atan_tabla = 32'sh000000E5;
                4'd15: atan_tabla = 32'sh00000073;

                default:
                    atan_tabla = 32'sd0;

            endcase
        end

    endfunction

    wire signed [31:0] atan_valor;

    assign atan_valor = atan_tabla(iter);

    wire signed [31:0] x_shifted;
    wire signed [31:0] y_shifted;

    assign x_shifted = x >>> iter;
    assign y_shifted = y >>> iter;

    wire signed [31:0] x_next;
    wire signed [31:0] y_next;
    wire signed [31:0] z_next;

    assign x_next =
        (z >= 0)
        ? x - y_shifted
        : x + y_shifted;

    assign y_next =
        (z >= 0)
        ? y + x_shifted
        : y - x_shifted;

    assign z_next =
        (z >= 0)
        ? z - atan_valor
        : z + atan_valor;

    always @(posedge clk) begin

        if (reset) begin

            state   <= IDLE;
            iter    <= 4'd0;

            x       <= 32'sd0;
            y       <= 32'sd0;
            z       <= 32'sd0;

            cos_out <= 32'sd0;
            sin_out <= 32'sd0;

            done    <= 1'b0;

        end
        else begin

            case (state)

                IDLE: begin

                    done <= 1'b0;
                    iter <= 4'd0;

                    if (start == 1'b1)
                        state <= INIT;
                    else
                        state <= IDLE;

                end

                INIT: begin

                    x <= K_INV_16;
                    y <= 32'sd0;
                    z <= angle;

                    iter <= 4'd0;

                    done <= 1'b0;

                    state <= ITERATE;

                end

                ITERATE: begin

                    x <= x_next;
                    y <= y_next;
                    z <= z_next;

                    if (iter == 4'd15) begin

                        cos_out <= x_next;
                        sin_out <= y_next;

                        state <= DONE;

                    end
                    else begin

                        iter <= iter + 1'b1;
                        state <= ITERATE;

                    end

                end

                DONE: begin

                    done <= 1'b1;

                    if (start == 1'b0)
                        state <= IDLE;
                    else
                        state <= DONE;

                end

                default: begin

                    state <= IDLE;
                    done  <= 1'b0;

                end

            endcase

        end

    end

endmodule
